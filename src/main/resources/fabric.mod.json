{
    "schemaVersion": 1,
    "id": "alterauth",
    "version": "${version}",
    "name": "AlterAuth",
    "description": "Use third-party authentication servers, like Ely.by, on your server without interfering with Mojang authentication",
    "authors": ["GGSkyOne"],
    "contact": {
        "homepage": "https://modrinth.com/mod/alternative-authentication",
        "sources": "https://github.com/gt-ayush/alterauth",
        "issues": "https://github.com/gt-ayush/alterauth/issues"
    },
    "license": "MIT",
    "environment": "server",
    "entrypoints": {
        "server": ["one.ggsky.alternativeauth.AlternativeAuthentication"]
    },
    "mixins": ["alterauth.mixins.json"],
    "depends": {
        "minecraft": [">=26.3", "<=26.3"],
        "fabric-api": "*"
    }
}
